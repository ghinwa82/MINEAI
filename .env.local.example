# ─────────────────────────────────────────────────────────────────────
# MineAI Node — environment contract
# Copy to .env.local and fill in. Every value below is optional: the
# platform degrades to a clearly-labelled sandbox rail when a key is
# missing, and never fails to boot because of an absent secret.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://mineai-node.vercel.app

# ── Stripe checkout rail ───────────────────────────────────────────────
# sk_live_… / sk_test_… — without a key the storefront runs on a sandbox
# rail and the storefront says so out loud.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The connected account that receives payouts. Read by
# /api/wallet/withdraw to report the live verification state.
STRIPE_CONNECT_ACCOUNT_ID=

# Signing secret for Stripe webhooks.
STRIPE_WEBHOOK_SECRET=

# ── Cryptographic settlement wallets ───────────────────────────────────
TREASURY_SOL_WALLET=MineAi7kX4hUeP98wYQvE1zR8sL7mM5nP6qD3fB2aC1
TREASURY_EVM_WALLET=0x71C94b6e5fD8C618bF72088820B88c3a9f0B3e12

# ── Supabase edge persistence ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Autonomous agent engine ───────────────────────────────────────────
# Vercel sends this value as "Authorization: Bearer $CRON_SECRET" on every
# scheduled request to /api/autonomous.
CRON_SECRET=mineai_depin_autonomous_cron_token_2025

# ── Optional model bridge ──────────────────────────────────────────────
GROQ_API_KEY=
