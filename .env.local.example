# ─────────────────────────────────────────────────────────────────────
# MineAI Node — environment contract
# Copy to .env.local and fill in. Every value below is optional: the
# platform degrades to a clearly-labelled sandbox rail when a key is
# missing, and never fails to boot because of an absent secret.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://mineai-three.vercel.app

# ── Field encryption ───────────────────────────────────────────────────
# 32 random bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Fiat rails ─────────────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Kashier (Visa, Mastercard, Meeza in USD and EGP)
KASHIER_MERCHANT_ID=
KASHIER_SECRET_KEY=
KASHIER_WEBHOOK_SECRET=
KASHIER_MODE=test
EGP_PER_USD=48.65

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# ── Owner settlement destinations ──────────────────────────────────────
OWNER_BANK_HOLDER=
OWNER_BANK_NAME=
OWNER_BANK_IBAN=
OWNER_BANK_SWIFT=
OWNER_BANK_COUNTRY=AE

OWNER_EVM_WALLET=
OWNER_TRON_WALLET=
OWNER_SOL_WALLET=
OWNER_TON_WALLET=
OWNER_BTC_WALLET=
OWNER_WALLET_MODE=demo

# ── $MINEAI token ──────────────────────────────────────────────────────
NEXT_PUBLIC_MINEAI_BSC_CONTRACT=
NEXT_PUBLIC_MINEAI_BSC_TESTNET_CONTRACT=
NEXT_PUBLIC_MINEAI_ETH_CONTRACT=
NEXT_PUBLIC_MINEAI_DEX_URL=

# ── Contract deployment (scripts/deploy-mineai.js) ─────────────────────
DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
BSC_RPC=
BSC_TESTNET_RPC=
ETH_RPC=
ARB_RPC=
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# ── Supabase edge persistence ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Autonomous agent engine + mining cron ──────────────────────────────
CRON_SECRET=

# ── Optional model bridge ──────────────────────────────────────────────
GROQ_API_KEY=
