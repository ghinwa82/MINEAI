{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }]
    }
  ],
  "crons": [
    {
      "path": "/api/autonomous",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/mining/cron",
      "schedule": "30 3 * * *"
    }
  ]
}
