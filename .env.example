# ─────────────────────────────────────────────────────────────────────
# MineAI Node — environment contract
#
# Copy to .env.local and fill in. Every processor key is optional: a rail
# without a key downgrades to a clearly-labelled sandbox session instead of
# failing the build. Wallet and bank values are the owner's real settlement
# destinations and are never committed.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://mineai-three.vercel.app

# ── Field encryption ───────────────────────────────────────────────────
# 32 random bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Fiat rails ─────────────────────────────────────────────────────────
# Paymob (cards, Apple Pay, local wallets across MENA)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Lemon Squeezy (merchant of record, worldwide)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Stripe Checkout + Connect
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# ── Owner settlement destinations ──────────────────────────────────────
# Fiat: the bank account every card payout is routed to.
OWNER_BANK_HOLDER=
OWNER_BANK_NAME=
OWNER_BANK_IBAN=
OWNER_BANK_SWIFT=
OWNER_BANK_COUNTRY=AE

# Crypto: one owner wallet per chain family. The EVM wallet serves BEP-20,
# Arbitrum One and ERC-20. Set OWNER_WALLET_MODE=live once these are real.
OWNER_EVM_WALLET=
OWNER_TRON_WALLET=
OWNER_SOL_WALLET=
OWNER_TON_WALLET=
OWNER_BTC_WALLET=
OWNER_WALLET_MODE=demo

# ── $MINEAI token ──────────────────────────────────────────────────────
# Addresses after mainnet deployment (BSC and/or Ethereum).
NEXT_PUBLIC_MINEAI_BSC_CONTRACT=
NEXT_PUBLIC_MINEAI_ETH_CONTRACT=
NEXT_PUBLIC_MINEAI_DEX_URL=

# ── Contract deployment (scripts/deploy-mineai.js) ─────────────────────
# Never commit a funded key. Use a dedicated deployer wallet.
DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
BSC_RPC=
BSC_TESTNET_RPC=
ETH_RPC=
ARB_RPC=
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# ── Supabase edge persistence ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Autonomous agent engine + mining cron ──────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" on every scheduled call.
CRON_SECRET=

# ── Optional model bridge ──────────────────────────────────────────────
GROQ_API_KEY=
